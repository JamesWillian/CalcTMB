    <!-- Acerca de -->
    <string name="o_que_eh_tmb">¿Qué es TMB?</string>
    <string name="sobre_tmb">El TMB representa la cantidad de energía (calorías) que tu cuerpo consume en reposo absoluto, solo para mantener funciones vitales como la respiración, la circulación sanguínea y la temperatura corporal.</string>
    <string name="sobre_gasto_calorico">Además del TMB, el cuerpo gasta energía en actividades físicas, digestión y otros procesos. Por eso, el gasto calórico total suele ser mayor que el TMB. Esta aplicación estima valores para diferentes objetivos.</string>
    <string name="ganhar_peso_sobre">Aumentar de peso: Se estima que consumirás un 40% más de calorías de las que quemas (excedente calórico).</string>
    <string name="hipertrofia_sobre">Hipertrofia: Se estima consumir un 20% más de calorías de las que quemas, centrándote en las proteínas y el entrenamiento de fuerza.</string>
    <string name="perder_peso_sobre">Perder peso: Se estima que quemas un 20% más de calorías de las que consumes (déficit calórico).</string>
