    <string name="hipertrofia_sobre">Hipertrofia: Estima-se consumir 20% mais calorias do que gasta, com foco em proteínas e treino de força.</string>
    <string name="perder_peso_sobre">Perder peso: Estima-se gastar 20% mais calorias do que consome (déficit calórico).</string>
